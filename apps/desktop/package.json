{
  "name": "@telemetry-desk/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "TelemetryDesk desktop shell",
  "author": "TelemetryDesk",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "electron dist/main/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist:win": "npm run build -w @telemetry-desk/dashboard && npm run build && electron-builder --win nsis --x64 --publish never --config electron-builder.yml"
  },
  "dependencies": {
    "@telemetry-desk/application": "^0.1.0",
    "@telemetry-desk/infrastructure": "^0.1.0",
    "@telemetry-desk/platform": "^0.1.0",
    "@telemetry-desk/shared": "^0.1.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.15.3"
  }
}
